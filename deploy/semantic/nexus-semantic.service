[Unit]
Description=Nexus semantic recall (embedding service; reads the Nexus database read-only)
After=network.target nexus-main.service

[Service]
User=nexus
Group=nexus
WorkingDirectory=/srv/nexus/app
Environment=PYTHONPATH=/srv/nexus/app/src
Environment=HF_HOME=/srv/nexus-semantic/hf
Environment=HF_HUB_OFFLINE=1
# 3 of 4 cores: the backfill must not starve nexus-main
ExecStart=/srv/nexus-semantic/venv/bin/python -X utf8 -m nexus.semantic_service --db /srv/nexus/data/main.sqlite --vectors /srv/nexus-semantic/vectors.sqlite --backend st --model BAAI/bge-m3 --threads 3 --host 127.0.0.1 --port 8767
Nice=10
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# the database directory stays writable only because SQLite read-only WAL readers need the -shm file
ReadWritePaths=/srv/nexus-semantic /srv/nexus/data
ReadOnlyPaths=/srv/nexus/app
MemoryMax=8G
UMask=0027

[Install]
WantedBy=multi-user.target
